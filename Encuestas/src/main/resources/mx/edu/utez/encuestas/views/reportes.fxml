<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.edu.utez.encuestas.controller.ReportesController"
            style="-fx-background-color: #f4f8fc;">

    <!-- Encabezado azul -->
    <top>
        <VBox spacing="16" style="-fx-padding: 24; -fx-background-color: #1f2937;">
            <!-- Título principal -->
            <Label text="Estadísticas de Encuestas"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>

            <!--  botón  y la caja de encuestas-->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Encuesta:" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                <ComboBox fx:id="cmbEncuestas" prefWidth="220" style="-fx-background-color: white;"/>
                <Button text="Actualizar" onAction="#actualizarGrafico"
                        style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Contenido principal de la vista -->
    <center>
        <VBox spacing="16" alignment="CENTER" style="-fx-padding: 32;">
            <!-- Título centrado de la encuesta -->
            <Label fx:id="lblTituloEncuesta" text="Encuesta: IA"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

            <!-- Gráfico -->
            <BarChart fx:id="barChart"
                      title="Respuestas por opción"
                      prefWidth="900" prefHeight="420"
                      style="-fx-background-color: white; -fx-border-color: #cce0ff; -fx-border-width: 2; -fx-padding: 16;">
                <xAxis>
                    <CategoryAxis label="Opciones"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Total de respuestas"/>
                </yAxis>
            </BarChart>
        </VBox>
    </center>
</BorderPane>
