<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="mx.edu.utez.encuestas.controller.AgregarPreguntasController"
      spacing="15" alignment="TOP_CENTER"
      stylesheets="@../css/agregarPreguntas.css"
      styleClass="root"
      prefWidth="400" prefHeight="400">

    <Label text="Preguntas" styleClass="titulo">
        <tooltip>
            <Tooltip text="Crea o edita una pregunta para la encuesta" />
        </tooltip>
    </Label>
    <TextArea fx:id="preguntaField"
              promptText="Escribe la pregunta aquí..."
              wrapText="true"
              prefRowCount="3"
              styleClass="text-field">
        <tooltip>
            <Tooltip text="Escribe la pregunta que aparecerá en la encuesta" />
        </tooltip>
    </TextArea>
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED">
        <VBox fx:id="opcionesBox" spacing="10">
            <!-- Se agregan dinámicamente las opciones -->
        </VBox>
    </ScrollPane>

    <Separator />
    <Button text="Guardar pregunta"
            onAction="#onGuardarPregunta"
            styleClass="save-button">
        <tooltip>
            <Tooltip text="Guarda esta pregunta y sus opciones" />
        </tooltip>
    </Button>

</VBox>
