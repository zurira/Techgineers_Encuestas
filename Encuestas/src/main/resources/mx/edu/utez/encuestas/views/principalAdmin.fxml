<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="mx.edu.utez.encuestas.controller.PrincipalAdmin"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../css/principalAdmin.css">

    <BorderPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Menú lateral izquierdo -->
        <left>
            <VBox fx:id="sidebar" prefWidth="240.0" styleClass="sidebar">
                <Label text="Panel Administrador" styleClass="sidebar-brand"/>
                <Separator styleClass="sidebar-separator"/>
                <Button text="Dashboard" styleClass="sidebar-button" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fa-home"/></graphic>
                </Button>
                <Button text="Docentes" styleClass="sidebar-button-selected" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fa-users"/></graphic>
                </Button>
            </VBox>
        </left>
        <center>
            <VBox spacing="12">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>

                <HBox fx:id="header" alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
                    <Label text="Docentes" styleClass="header-title"/>
                    <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" styleClass="user-info-box">
                        <children>
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <FontIcon iconLiteral="fa-user" styleClass="avatar-icon"/>
                                <Label fx:id="nombreAdmin" styleClass="avatar-name" text="Administrador"/>
                                <Button fx:id="logoutButton" styleClass="logout-button">
                                    <graphic>
                                        <FontIcon iconLiteral="fa-sign-out" styleClass="avatar-icon"/>
                                    </graphic>
                                </Button>
                            </HBox>
                        </children>
                    </VBox>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="buscarField" promptText="Buscar" styleClass="search-field" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAgregarDocente" text="Agregar" styleClass="add-button">
                        <graphic><FontIcon iconLiteral="fa-plus" styleClass="add-icon"/></graphic>
                    </Button>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-background">
                    <content>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="20" right="20" bottom="20" left="20"/>
                            </padding>

                            <Label text="Información sobre docentes" styleClass="section-title"/>

                            <TableView fx:id="tableViewDocentes" prefHeight="450.0" prefWidth="800" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNo" prefWidth="60.0" text="No." />
                                    <TableColumn fx:id="colNombre" prefWidth="240.0" text="Nombre" />
                                    <TableColumn fx:id="colCorreo" prefWidth="240.0" text="Correo" />
                                    <TableColumn fx:id="colUsuario" prefWidth="240.0" text="Usuario" />
                                </columns>
                            </TableView>

                            <Label fx:id="lblSinResultados"
                                   text="No se encontraron resultados"
                                   visible="false"
                                   style="-fx-text-fill: brown; -fx-font-weight: bold;"
                                   alignment="CENTER" maxWidth="Infinity"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane>